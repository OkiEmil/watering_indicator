    "        \n",
    "        x = current_field[\"entry_id\"]\n",
    "        y = current_field[field_nr]\n",
    "        x = sm.add_constant(x)\n",
    "        model = sm.OLS(y, x)\n",
    "        results = model.fit()\n",
