    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "data = pd.read_csv(\"./feeds.csv\")\n",
    "\n",
    "field8 = data[data[\"field8\"]>10]\n",
    "field8.head()\n",
    "ax = plt.gca()\n",
    "ax.scatter(x=field8[\"entry_id\"], y=field8[\"field8\"])\n",
    "ax.set_yscale('log')\n",
    "plt.show()"
   ]
